# Copy to .env for local Compose use. Keep .env private; these values are intentionally blank.
POSTGRES_DB=freshline
POSTGRES_USER=freshline
POSTGRES_PASSWORD=
FRESHLINE_DEMO_ACCESS_CODE=

# Local default. Set the public hostname and FRESHLINE_COOKIE_SECURE=true on a TLS deployment.
PUBLIC_HOST=localhost
FRESHLINE_COOKIE_SECURE=false
DEMO_MODE=true
DEMO_SEED=404
SIMULATOR_INTERVAL_SECONDS=15
